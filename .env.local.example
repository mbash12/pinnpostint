# Local overrides (gitignored). Loaded on top of .env by API / Admin / Mobile.
#
# For local API against Docker DB published on localhost:

POSTGRES_HOST=localhost
REDIS_HOST=127.0.0.1
DATABASE_URL=postgresql://demo:change-me@localhost:5432/pinpost
# Must match the Redis instance on localhost (e.g. redis-cache often uses "demo";
# pinn-redis from docker-compose uses REDIS_PASSWORD from root .env, default "redis").
REDIS_PASSWORD=demo
REDIS_URL=redis://:demo@127.0.0.1:6379

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
API_BASE_URL=http://localhost:3001/api/v1
