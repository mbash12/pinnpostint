#!/bin/bash

# PinNPost Centralized CLI Helper
# Usage: ./pinn [command] [options]

# Capture the absolute path to the project root at startup
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Config
COMPOSE_FILE="docker/docker-compose.yml"
ENV_FILE=".env"
APPS=("api" "admin" "mobile")

# Keys compose interpolates from the shell (env_file alone is NOT enough).
COMPOSE_EXPORT_KEYS=(
  POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB
  REDIS_PASSWORD
  API_PORT ADMIN_PORT MOBILE_PORT
  NEXT_PUBLIC_API_URL
)

# Global flag for local development
LOCAL_MODE=false

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

check_docker() {
    if ! command -v docker &> /dev/null; then
        log_error "Docker not found. Please install Docker first."
        exit 1
    fi
    if ! command -v docker compose &> /dev/null; then
        log_error "Docker Compose not found. Please install Docker Compose."
        exit 1
    fi
}

# Export a single KEY=value from a dotenv file without sourcing the whole file.
export_env_key_from_file() {
    local file="$1" key="$2" line val
    [ -f "$file" ] || return 0
    line="$(grep -E "^${key}=" "$file" | tail -1 || true)"
    [ -n "$line" ] || return 0
    val="${line#*=}"
    export "${key}=${val}"
}

# Load root .env (+ optional .env.local) for compose interpolation only.
load_compose_env() {
    local skip_local="${1:-false}"
    local key
    for key in "${COMPOSE_EXPORT_KEYS[@]}"; do
        export_env_key_from_file "$PROJECT_ROOT/.env" "$key"
    done
    if [ "$skip_local" != "true" ] && [ -f "$PROJECT_ROOT/.env.local" ]; then
        for key in "${COMPOSE_EXPORT_KEYS[@]}"; do
            export_env_key_from_file "$PROJECT_ROOT/.env.local" "$key"
        done
    fi
}

cd_project_root() {
    cd "$PROJECT_ROOT"
    if [ "$LOCAL_MODE" = true ]; then
        load_compose_env
    else
        load_compose_env true
    fi
}

cmd_env_sync() {
    cd "$PROJECT_ROOT"
    if [ "${1:-}" = "--production" ]; then
        log_info "Syncing per-app .env from root (production)..."
        node scripts/env-sync.js --production
    else
        log_info "Syncing per-app .env + .env.local from root..."
        node scripts/env-sync.js
    fi
    log_success "Env sync complete"
}

cmd_env_check() {
    cd "$PROJECT_ROOT"
    node scripts/env-sync.js --check
}

# ==================== BUILD COMMANDS ====================

_cmd_build_one() {
    local app=$1
    case $app in
        api)
            log_info "Building API..."
            cd api
            if [ ! -d "node_modules" ]; then
                sed -i 's/"prepare": "husky install"/"prepare": ""/g' package.json
                npm install
                sed -i 's/"prepare": ""/"prepare": "husky install"/g' package.json
            fi
            npx prisma generate
            npm run build
            cd ..
            log_success "API build complete. Output: api/dist/"
            ;;
        admin)
            log_info "Building Admin..."
            cd admin
            if [ ! -d "node_modules" ]; then
                sed -i 's/"prepare": "husky install"/"prepare": ""/g' package.json 2>/dev/null || true
                npm install
                sed -i 's/"prepare": ""/"prepare": "husky install"/g' package.json 2>/dev/null || true
            fi
            rm -rf .next
            # Next loads admin/.env (+ .env.local); we do not use .env.production
            NODE_ENV=production npm run build
            cd ..
            log_success "Admin build complete. Output: admin/.next/"
            ;;
        mobile)
            log_info "Building Mobile (Expo Web)..."
            cd mobile
            if [ ! -d "node_modules" ]; then
                sed -i 's/"prepare": "husky install"/"prepare": ""/g' package.json 2>/dev/null || true
                npm install
                sed -i 's/"prepare": ""/"prepare": "husky install"/g' package.json 2>/dev/null || true
            fi
            set -a
            # shellcheck disable=SC1091
            # dotenv.parse handles spaces, =, and unquoted values safely.
            source <(node -e "
              const fs = require('fs');
              const dotenv = require('dotenv');
              function load(p) { return fs.existsSync(p) ? dotenv.parse(fs.readFileSync(p)) : {}; }
              const env = { ...load('.env'), ...load('.env.local') };
              for (const [k, v] of Object.entries(env)) {
                console.log('export -- ' + JSON.stringify(k) + '=' + JSON.stringify(v));
              }
            ")
            set +a
            rm -rf .expo web-build dist node_modules/.cache 2>/dev/null || true
            npx expo export --platform web --clear
            cp firebase-messaging-sw.js dist/ 2>/dev/null || true
            cp firebase-messaging-sw.js dist/_expo/static/ 2>/dev/null || true
            cd ..
            log_success "Mobile build complete. Output: mobile/dist/"
            ;;
    esac
}

cmd_build() {
    local app=$1
    cd_project_root
    if [ "$LOCAL_MODE" = true ]; then
        cmd_env_sync
    else
        cmd_env_sync --production
    fi
    case $app in
        all)
            log_info "Building all apps..."
            for a in "${APPS[@]}"; do
                _cmd_build_one "$a"
            done
            log_success "All builds complete!"
            ;;
        api|admin|mobile)
            _cmd_build_one "$app"
            ;;
        *)
            log_error "Unknown app: $app"
            log_info "Available: api, admin, mobile, all"
            exit 1
            ;;
    esac
}

cmd_build_watch() {
    local app=$1
    cd_project_root
    
    log_info "Starting watch mode for $app..."
    case $app in
        api)
            cd api && npx nodemon --exec "npm run build && docker compose -f ../$COMPOSE_FILE restart api" --watch src --ext ts
            ;;
        admin)
            cd admin && npx chokidar "src/**/*" -c "npm run build && docker compose -f ../$COMPOSE_FILE restart admin"
            ;;
        *)
            log_error "Watch mode only available for api and admin"
            exit 1
            ;;
    esac
}

# ==================== DOCKER COMMANDS ====================

cmd_up() {
    cd_project_root
    if [ "$LOCAL_MODE" = true ]; then
        cmd_env_sync
    else
        cmd_env_sync --production
    fi
    log_info "Starting all services..."
    docker compose -f "$COMPOSE_FILE" up -d
    log_success "Services started!"
    cmd_status
}

cmd_down() {
    cd_project_root
    log_info "Stopping all services..."
    docker compose -f "$COMPOSE_FILE" down
    log_success "Services stopped!"
}

cmd_restart() {
    local service=$1
    cd_project_root

    if [ -z "$service" ]; then
        log_info "Restarting all services..."
        docker compose -f "$COMPOSE_FILE" restart
    else
        log_info "Restarting service: $service"
        docker compose -f "$COMPOSE_FILE" restart "$service"
    fi
    log_success "Restart complete!"
}

cmd_recreate() {
    local service=$1
    cd_project_root
    if [ "$LOCAL_MODE" = true ]; then
        cmd_env_sync
    else
        cmd_env_sync --production
    fi

    if [ -z "$service" ]; then
        log_info "Force recreating all services (this will reload environment variables)..."
        docker compose -f "$COMPOSE_FILE" up -d --force-recreate
    else
        log_info "Force recreating service: $service (this will reload environment variables)..."
        docker compose -f "$COMPOSE_FILE" up -d --force-recreate --no-deps "$service"
    fi
    log_success "Recreate complete! Environment variables have been reloaded."
    cmd_status
}

# Heal: hard-rebuild a container's writable layer. Use when a container is
# stuck with "exec /usr/local/bin/docker-entrypoint.sh: permission denied",
# "OCI runtime create failed", or any crash loop that `restart` won't fix.
cmd_heal() {
    local service=$1
    cd_project_root

    if [ -z "$service" ]; then
        log_warn "This will remove and recreate ALL containers (fresh overlay layers)."
        read -p "Are you sure? (yes/no): " confirm
        [ "$confirm" = "yes" ] || { log_info "Cancelled."; return 0; }
        log_info "Healing all services..."
        docker compose -f "$COMPOSE_FILE" rm -sf
        docker compose -f "$COMPOSE_FILE" up -d
    else
        log_info "Healing $service (rm -sf + pull + up -d)..."
        # Try to pull the image first in case a local copy is corrupted.
        local image
        image=$(docker compose -f "$COMPOSE_FILE" config --images "$service" 2>/dev/null | head -1)
        if [ -n "$image" ]; then
            log_info "Pulling $image ..."
            docker pull "$image" >/dev/null 2>&1 || log_warn "Pull failed (offline?), continuing anyway"
        fi
        docker compose -f "$COMPOSE_FILE" rm -sf "$service"
        # --no-deps: allow healing api even if db is temporarily unhealthy
        docker compose -f "$COMPOSE_FILE" up -d --no-deps "$service"
    fi
    log_success "Heal complete!"
    cmd_status
}

cmd_logs() {
    local service=$1
    cd_project_root
    
    if [ -z "$service" ]; then
        docker compose -f "$COMPOSE_FILE" logs -f
    else
        docker compose -f "$COMPOSE_FILE" logs -f "$service"
    fi
}

cmd_status() {
    cd_project_root
    log_info "Service Status:"
    docker compose -f "$COMPOSE_FILE" ps
}

cmd_shell() {
    local service=$1
    cd_project_root
    
    if [ -z "$service" ]; then
        log_error "Please specify a service (api, admin, mobile, db, redis)"
        exit 1
    fi
    
    log_info "Opening shell in $service..."
    docker compose -f "$COMPOSE_FILE" exec "$service" sh
}

