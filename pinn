# ==================== MAIN ====================

main() {
    check_docker
    
    # Parse flags (before or after command)
    for arg in "$@"; do
        if [ "$arg" = "--local" ] || [ "$arg" = "-l" ]; then
            LOCAL_MODE=true
            log_info "Local mode enabled - using .env.development"
            break
        fi
    done
    
    # Remove flags from args
    args=()
    for arg in "$@"; do
        if [ "$arg" != "--local" ] && [ "$arg" != "-l" ]; then
            args+=("$arg")
        fi
    done
    set -- "${args[@]}"
    
    case $1 in
        # Build
        build|b) cmd_build "$2" ;;
        build:watch|bw) cmd_build_watch "$2" ;;
        
        # Docker
        up|start) cmd_up ;;
        down|stop) cmd_down ;;
        restart|r) cmd_restart "$2" ;;
        recreate|force-recreate) cmd_recreate "$2" ;;
        heal|fix) cmd_heal "$2" ;;
        doctor|diag) cmd_doctor ;;
        logs|l) cmd_logs "$2" ;;
        status|ps|s) cmd_status ;;
        shell|sh|exec) cmd_shell "$2" ;;

        # Watchdog
        watchdog:install|wd:install) cmd_watchdog_install ;;
        watchdog:uninstall|wd:uninstall) cmd_watchdog_uninstall ;;
        watchdog:run|wd:run) cmd_watchdog_run ;;
        watchdog:status|wd:status) cmd_watchdog_status ;;
        watchdog:logs|wd:logs) cmd_watchdog_logs ;;
        
        # Database
        db:migrate|migrate) cmd_db_migrate ;;
        db:migrate:deploy) cmd_db_migrate_deploy ;;
        db:generate|generate) cmd_db_generate ;;
        db:seed|seed) cmd_db_seed ;;
        db:studio|studio) cmd_db_studio ;;
        db:reset|reset) cmd_db_reset ;;
        db:backup|backup) cmd_db_backup ;;
        db:backup:list|backup:list) cmd_db_backup_list ;;
        db:restore|restore) cmd_db_restore "$2" ;;
        
        # Uploads
        uploads:backup) cmd_uploads_backup ;;
        uploads:restore) cmd_uploads_restore "$2" ;;
        
        # Backup schedule
        backup:schedule) cmd_backup_schedule ;;
        backup:unschedule) cmd_backup_unschedule ;;
        backup:verify) cmd_backup_verify ;;

        # SMS ops
        sms:catchup) cmd_sms_catchup "${@:2}" ;;
        
        # SSL
        ssl:generate) cmd_ssl_generate "$2" "$3" ;;
        ssl:generate:all) cmd_ssl_generate_all ;;
        ssl:renew) cmd_ssl_renew ;;
        ssl:test) cmd_ssl_test "$2" ;;

        # Env
        env:sync) cmd_env_sync "${@:2}" ;;
        env:check) cmd_env_check ;;
        env:encrypt) cmd_env_encrypt "$2" "$3" ;;
        env:decrypt) cmd_env_decrypt "$2" "$3" ;;

        # Deploy
        deploy|d) cmd_deploy ;;
        deploy:api) cmd_deploy_app "api" ;;
        deploy:admin) cmd_deploy_app "admin" ;;
        deploy:mobile) cmd_deploy_app "mobile" ;;
        
        # Setup
        setup|init) cmd_setup ;;
        clean) cmd_clean ;;
        
        # Help
        help|--help|-h|"") cmd_help ;;
        
        *) 
            log_error "Unknown command: $1"
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
