# PinNPost — edit this for production/Docker (+ .env.local for local)
#
# Then: ./pinn env:sync
#   → writes api|admin|mobile /.env and /.env.local only
#   (never .env.development / .env.production)
#
# Docker compose loads this root .env at runtime.
# Local yarn uses per-app .env.local (synced from root + .env.local).

NODE_ENV=production

# Postgres (Docker service name: db)
POSTGRES_DB=pinpost
POSTGRES_USER=demo
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
DATABASE_URL=postgresql://demo:change-me@db:5432/pinpost

# Redis (Docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379
REDIS_DB=0

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

API_PORT=3001
ADMIN_PORT=3000
MOBILE_PORT=8080
PORT=3001
API_VERSION=v1
DEV_MODE=false
JOB_QUEUE_ENABLED=true
JOB_CONCURRENCY=5
JOB_MAX_ATTEMPTS=3

# Public URLs (copied into admin/mobile on env:sync)
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_APP_NAME=Pin N Post Admin
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
EXPO_PUBLIC_ENV=production
API_BASE_URL=https://api.example.com/api/v1

# Domains for ./pinn ssl:generate:all
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
MOBILE_DOMAIN=app.example.com
SSL_EMAIL=admin@example.com

# Optional maps / payments (public keys only on frontend)
NEXT_PUBLIC_MAP_PROVIDER=google
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (synced to api/.env*)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=PinnPost

# SMS (synced to api/.env*)
SMS_PROVIDER=techbeeshive
SMS_BRAND=pinnpost
SMS_API_KEY=
SMS_SENDER_ID=PNPOST
SMS_BASE_URL=http://sms.techbeeshive.com/vb/apikey.php
SMS_FORMAT=json
SMS_UNICODE=false
SMS_USE_TEMPLATE_ID=false
SMS_DLT_TEMPLATE_ID=
SMS_OTP_TEMPLATE_ID=
SMS_AD_APPROVED_TEMPLATE_ID=
SMS_AD_REJECTED_TEMPLATE_ID=
SMS_AD_REVIEW_TEMPLATE_ID=
SMS_AD_EXPIRED_TEMPLATE_ID=
SMS_AD_EXTENDED_TEMPLATE_ID=
SMS_AD_WILL_EXPIRE_TEMPLATE_ID=

# Admin-only (synced to admin/.env*, not public)
HEAP_DUMP_SECRET=
