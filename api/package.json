{
  "name": "PinNPost",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "DATABASE_URL=postgresql://demo:demo@localhost:5432/pinpost REDIS_URL=redis://:demo@127.0.0.1:6379 REDIS_HOST=127.0.0.1 nodemon --exec ts-node --transpile-only src/server.ts",
    "build": "tsc && npm run build:seed && npm run copy:data",
    "build:seed": "npx tsc prisma/seed.ts --outDir dist --target ES2020 --module CommonJS --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
    "copy:data": "mkdir -p dist/data && cp -r src/data/* dist/data/",
    "start": "node --max-old-space-size=1024 dist/server.js",
    "start:vps": "NODE_ENV=production node --max-old-space-size=1024 dist/server.js",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:integration": "jest --config jest.integration.config.js --detectOpenHandles",
    "test:integration:watch": "jest --config jest.integration.config.js --watch --detectOpenHandles",
    "test:integration:coverage": "jest --config jest.integration.config.js --coverage --detectOpenHandles",
    "test:integration:run": "ts-node src/tests/integration/run-integration-tests.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "db:seed:dev": "ts-node prisma/seed.ts",
    "db:seed:build": "tsc prisma/seed.ts --outDir dist --target ES2020 --module CommonJS --moduleResolution node --esModuleInterop --allowSyntheticDefaultImports --skipLibCheck",
    "db:seed:attributes": "ts-node prisma/seed-attributes.ts",
    "db:studio": "prisma studio",
    "db:locations:fetch": "node scripts/fetch-location-data.js",
    "db:locations:seed": "ts-node prisma/seed-locations.ts",
    "db:locations:setup": "npm run db:locations:fetch && npm run db:locations:seed",
    "db:extract-major-states": "ts-node scripts/extract-major-states-pincode.ts",
    "db:seed-major-states": "ts-node prisma/seed-major-states.ts",
    "db:setup-major-states": "npm run db:extract-major-states && npm run db:seed-major-states",
    "create-super-admin": "node scripts/create-super-admin.js",
    "create-super-admin:ts": "ts-node scripts/create-super-admin.ts",
    "generate-swagger": "node scripts/generate-swagger.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.0",
    "@types/redis": "^4.0.10",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.10",
    "prisma": "^6.16.1",
    "razorpay": "^2.9.6",
    "redis": "^5.9.0",
    "sharp": "^0.34.3",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "uuid": "^13.0.0",
    "validator": "^13.15.15",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.5",
    "@types/socket.io": "^3.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.2",
    "typescript-eslint": "^8.50.0"
  }
}
